% theorems
\setbeamertemplate{theorems}[numbered]

% --- section & frame setting ---
% subsection
\newcommand{\strsubsec}{Section \thesection.\thesubsection}

% presents subtitle on each frame
\makeatletter
    \pretocmd\beamer@checkframetitle{%
        \ifnum\value{section}>0
            \framesubtitle{\thesection \, \secname}%
        \else
            \framesubtitle{}%
        \fi
    }
\makeatother

% avoid numbering of frames that are breaked into multiply slides
\setbeamertemplate{frametitle continuation}{}

% section page with the current section highlighted
\AtBeginSection[]
{
    \begingroup
    \setbeamertemplate{footline}{}
    \begin{frame}[plain]
        \begin{tikzpicture}[remember picture, overlay]
            \fill[maincolor] (current page.south west) rectangle (current page.north east);
            \fill[hhuNavy] (current page.south west) rectangle ([xshift=0.26\paperwidth]current page.north west);
            \fill[hhuGold] ([xshift=0.26\paperwidth]current page.south west) rectangle ([xshift=0.265\paperwidth]current page.north west);
            \node[anchor=center, opacity=0.12] at ([xshift=0.64\paperwidth,yshift=-0.50\paperheight]current page.north west)
                {\includegraphics[width=0.32\paperwidth]{\hhuEmblemPath}};
            \node[anchor=south west] at ([xshift=0.48cm,yshift=0.50cm]current page.south west)
                {\includegraphics[width=0.18\paperwidth]{\hhuWordmarkPath}};
        \end{tikzpicture}
        \vspace*{2.15cm}
        \hspace*{3.25cm}
        \begin{minipage}{0.56\textwidth}
            {\color{hhuGold}\bfseries\large Section \thesection}\par
            \vspace{0.25cm}
            {\color{white}\bfseries\LARGE \secname}\par
            \vspace{0.38cm}
            {\color{white!78}\rule{2.3cm}{1pt}}
        \end{minipage}
    \end{frame}
    \endgroup
}

% subsection title page
\AtBeginSubsection[]
{
    \begin{frame}{\,}{\thesection \, \secname}
        \fontfamily{ptm}\selectfont
        \centering\textsl{\textbf{\textcolor{maincolor}{
            \large Section \thesection.\thesubsection
            \vskip15pt
            \LARGE \subsecname
        }}}
    \end{frame}
}

% --- page elements ---
% frame title & subtitle layout
\setbeamertemplate{frametitle}{
    \begin{tikzpicture}[remember picture, overlay]
        \fill[hhuMist] (current page.north west) rectangle ([yshift=-1.34cm]current page.north east);
        \fill[maincolor] (current page.north west) rectangle ([xshift=0.20\paperwidth,yshift=-1.34cm]current page.north west);
        \fill[hhuGold] ([xshift=0.20\paperwidth]current page.north west) rectangle ([xshift=0.205\paperwidth,yshift=-1.34cm]current page.north west);
        \node[anchor=west, inner sep=0pt, text=white, font=\HHUBrandFont\bfseries\fontsize{7.4}{8.6}\selectfont] at ([xshift=0.34cm,yshift=-0.56cm]current page.north west)
            {HOHAI UNIVERSITY};
    \end{tikzpicture}
    \vspace*{-0.02cm}
    \begin{beamercolorbox}[wd=\textwidth, ht=1.12cm, dp=0.12cm]{frametitle}
        \hspace*{3.50cm}%
        \begin{minipage}{0.70\paperwidth}
            \usebeamerfont{frametitle}\insertframetitle\\[-1pt]
            {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}
        \end{minipage}
    \end{beamercolorbox}
}

% title page
\setbeamertemplate{title page}{
    \begin{tikzpicture}[remember picture, overlay]
        \fill[white] (current page.south west) rectangle (current page.north east);
        \fill[maincolor] (current page.south west) rectangle ([xshift=0.43\paperwidth]current page.north west);
        \fill[hhuGold] ([xshift=0.43\paperwidth]current page.south west) rectangle ([xshift=0.435\paperwidth]current page.north west);
        \node[anchor=north west, opacity=0.16] at ([xshift=0.55cm,yshift=-0.75cm]current page.north west)
            {\includegraphics[width=0.31\paperwidth]{\hhuEmblemPath}};
        \node[anchor=south west] at ([xshift=0.55cm,yshift=0.58cm]current page.south west)
            {\includegraphics[width=0.29\paperwidth]{\hhuWordmarkPath}};
        \node[anchor=north east, opacity=0.10] at ([xshift=-0.55cm,yshift=-0.55cm]current page.north east)
            {\includegraphics[width=0.22\paperwidth]{\hhuEmblemPath}};
    \end{tikzpicture}
    \vspace*{1.85cm}
    \hspace*{6.55cm}
    \begin{minipage}{0.55\textwidth}
        \raggedright
        {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle}\par
        \vspace{0.26cm}
        {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle}\par
        \vspace{0.56cm}
        {\color{hhuGold}\rule{1.35cm}{1.4pt}}\par
        \vspace{0.38cm}
        {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor}\par
        \vspace{0.16cm}
        {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate}
    \end{minipage}
}

\renewcommand{\maketitle}{
    \begingroup
        \setbeamertemplate{footline}{}
        \setbeamertemplate{headline}{}
        \setbeamertemplate{background}{}
        \begin{frame}
            \titlepage
        \end{frame}
    \endgroup
}

% Q&A page
\newcommand{\QApage}{
    \begingroup
        \setbeamertemplate{footline}{}
        \themecolor{colorbg}
        
        \begin{frame}{}
            \begin{tikzpicture}[remember picture, overlay]
                \fill[maincolor] (current page.south west) rectangle (current page.north east);
                \fill[hhuNavy] (current page.south west) rectangle ([xshift=0.24\paperwidth]current page.north west);
                \fill[hhuGold] ([xshift=0.24\paperwidth]current page.south west) rectangle ([xshift=0.245\paperwidth]current page.north west);
                \node[anchor=center, opacity=0.10] at ([xshift=0.68\paperwidth,yshift=-0.48\paperheight]current page.north west)
                    {\includegraphics[width=0.34\paperwidth]{\hhuEmblemPath}};
                \node[anchor=south west] at ([xshift=0.45cm,yshift=0.48cm]current page.south west)
                    {\includegraphics[width=0.17\paperwidth]{\hhuWordmarkPath}};
            \end{tikzpicture}
            \vspace*{2.55cm}
            \hspace*{2.95cm}
            \begin{minipage}{0.58\textwidth}
                \usebeamercolor[fg]{normal text}
                {\Huge\bfseries Q\&A}\par
                \vspace{0.3cm}
                {\large \qaStr}
            \end{minipage}
        \end{frame}
    \endgroup
}

% bibliography page
\newcommand{\bibliographpage}{
    \section{References}

    \begingroup
    \themecolor{colorbg}
    \begin{frame}[allowframebreaks]{References}{\,}
        \scriptsize
        \printbibliography[heading=none]
    \end{frame}
\endgroup
}

