\setbeamertemplate{navigation symbols}{}

% footline
\newcommand{\@footlinepayoff}{Hohai University}
\setbeamertemplate{footline}{
    \begin{tikzpicture}[remember picture, overlay]
        \fill[hhuMist] (current page.south west) rectangle ([yshift=0.34cm]current page.south east);
        \fill[maincolor] (current page.south west) rectangle ([xshift=0.23\paperwidth,yshift=0.34cm]current page.south west);
    \end{tikzpicture}
    \begin{beamercolorbox}[wd=\paperwidth, ht=0.34cm, dp=0.08cm, leftskip=0.62cm, rightskip=0.62cm]{footline}
        \usebeamerfont{footline}
        \textcolor{white}{\@footlinepayoff}\hfill
        \textcolor{hhuMuted}{\insertshorttitle}\hspace{0.45cm}
        \textcolor{maincolor}{\insertframenumber/\inserttotalframenumber}
    \end{beamercolorbox}
}

\newcommand{\footlinecolor}[1]{
    % if #1 is empty, makes footline transparent
    \ifstrempty{#1}{
        \renewcommand{\@footlinepayoff}{}
        \setbeamercolor{footline}{bg=}
    }{
        \renewcommand{\@footlinepayoff}{Hohai University}
        \setbeamercolor{footline}{fg=white, bg=#1}
    }
}
\footlinecolor{} % default: no footline

